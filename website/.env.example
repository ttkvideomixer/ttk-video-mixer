# TTK VIDEO MIXER — website. Copie para ".env.local" e preencha.
# NUNCA commite ".env.local" preenchido (já está no .gitignore).

# ---------------------------------------------------------------------------
# Supabase — MESMO projeto usado pelo desktop (mesmos usuários, mesmo trial).
# Valores públicos apenas (anon key), iguais aos que já existem no app desktop.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do próprio site (usada em OAuth redirect, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Download dos instaladores — resolvido via GitHub Releases do repositório
# do app desktop. Sem isso configurado, a página de download mostra um
# estado honesto de "build ainda não publicada" em vez de um link inventado.
# ---------------------------------------------------------------------------
GITHUB_REPOSITORY=
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Opcional
# ---------------------------------------------------------------------------
SUPPORT_EMAIL=suporte@ttkvideomixer.com
NEXT_PUBLIC_TERMS_URL=/termos
NEXT_PUBLIC_PRIVACY_URL=/privacidade

# Adapter de e-mail (ver src/lib/email.ts). Deixe vazio para apenas logar
# localmente em desenvolvimento — nenhum serviço pago é exigido para rodar.
RESEND_API_KEY=
EMAIL_FROM=TTK Video Mixer <no-reply@ttkvideomixer.com>

# Apenas para desenvolvimento local: serve o instalador Windows já gerado em
# ../release (build real, não inventado) sem precisar de GitHub Releases.
# NUNCA usado quando NODE_ENV=production.
DEV_LOCAL_WINDOWS_INSTALLER_PATH=../release

# ---------------------------------------------------------------------------
# NÃO ADICIONE AQUI: SUPABASE_SERVICE_ROLE_KEY.
# O site (Next.js) nunca precisa dela — todas as ações do /admin passam por
# RLS + funções SECURITY DEFINER usando a sessão do próprio admin, e as
# poucas operações que exigem a service role (Pagar.me, revogar sessões,
# reprocessar webhook) rodam na Edge Function `admin-actions` do Supabase.
# A ÚNICA exceção é `scripts/promote-admin.mjs` — que lê SUPABASE_URL e
# SUPABASE_SERVICE_ROLE_KEY diretamente do ambiente do terminal (nunca deste
# arquivo) só para criar o primeiro super_admin. Veja README.md.
# ---------------------------------------------------------------------------
