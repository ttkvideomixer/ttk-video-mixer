# Video Mixer — variáveis de ambiente para o sistema comercial.
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA commite o arquivo ".env" preenchido (já está no .gitignore).

# ---------------------------------------------------------------------------
# Desktop (Electron) — SOMENTE valores públicos.
# Injetados no bundle do renderer/main via Vite (prefixo VITE_).
# NUNCA coloque aqui: service role key, secret key da Pagar.me,
# client secret do Google, ou qualquer outra credencial privada.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Backend (Supabase Edge Functions) — segredos.
# Configure estes valores como "secrets" do projeto Supabase
# (supabase secrets set ...), nunca dentro do app desktop.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PAGARME_SECRET_KEY=
PAGARME_PLAN_ID=
PAGARME_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APP_PUBLIC_URL=
APP_DEEP_LINK_SCHEME=videomixer

# ---------------------------------------------------------------------------
# Opcional
# ---------------------------------------------------------------------------
# production | sandbox — controla qual ambiente da Pagar.me é usado.
PAYMENT_ENV=sandbox
# Mantenha "false" até existir integração real com Apple Pay configurada.
APPLE_PAY_ENABLED=false
# Permite liberar o plano Pro sem pagamento real, apenas em desenvolvimento.
# Ignorado sempre que NODE_ENV=production.
BILLING_MOCK=false
